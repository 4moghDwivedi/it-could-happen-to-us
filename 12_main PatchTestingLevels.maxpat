, 			{
				"box" : 				{
					"coll_data" : 					{
						"count" : 11,
						"data" : [ 							{
								"key" : 1,
								"value" : [ "u saw the news?" ]
							}
, 							{
								"key" : 2,
								"value" : [ "about the plane crash" ]
							}
, 							{
								"key" : 3,
								"value" : [ "Omg yes it was so sad." ]
							}
, 							{
								"key" : 4,
								"value" : [ "Thank god im on a train" ]
							}
, 							{
								"key" : 5,
								"value" : [ "r u afraid of flying?" ]
							}
, 							{
								"key" : 6,
								"value" : [ "No not really. Train is just more convenient and the station is close to my apt too" ]
							}
, 							{
								"key" : 7,
								"value" : [ "Plus I can sleep more comfortably" ]
							}
, 							{
								"key" : 8,
								"value" : [ "oh right back bay station is pretty close to ur place" ]
							}
, 							{
								"key" : 9,
								"value" : [ "i’m watching the news with my bro rn, it’s just crazy though" ]
							}
, 							{
								"key" : 10,
								"value" : [ "like u just can’t imagine anything like it because u’ll never know when it happens" ]
							}
, 							{
								"key" : 11,
								"value" : [ "Also sometimes Amtrak trains are just really cheap, it’s kinda funny. Like why would I sit on an uncomfortable seat on the plane and go through so much trouble to go thru security and stuff it’s just too much. Plus I don’t want to pay T fare to go back either" ]
							}
 ]
					}
,
