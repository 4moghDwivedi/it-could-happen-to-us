						"data" : [ 							{
								"key" : 1,
								"value" : [ "idk why it’s affecting me so much?" ]
							}
, 							{
								"key" : 2,
								"value" : [ "there is always a lot of suffering in the world right" ]
							}
, 							{
								"key" : 3,
								"value" : [ "but this news just hit different idk" ]
							}
, 							{
								"key" : 4,
								"value" : [ "Maybe because you know it could happen to you" ]
							}
, 							{
								"key" : 5,
								"value" : [ "I feel like it’s easy to detach sometimes if the suffering is far away from you or if circumstances are very different to yours" ]
							}
, 							{
								"key" : 6,
								"value" : [ "But since we all take plans and trains and all we know it could happen to us" ]
							}
, 							{
